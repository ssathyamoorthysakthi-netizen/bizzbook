# ---- BizBook environment ----
# Copy this file to .env for local development, or set these values in your
# host's dashboard (Render > Environment). Never commit a real .env file.

# MongoDB Atlas connection string.
# Local development (default, no .env needed): mongodb://127.0.0.1:27017
# Production example:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017

# Database name.
MONGO_DB=bizbook

# Secret used to sign JWT session tokens.
# REQUIRED when NODE_ENV=production — the server refuses to boot without it.
# Generate a strong value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# HTTP port. Render sets this automatically; leave unset locally to use 8765.
# PORT=8765

# Bind address. Use 0.0.0.0 in production so Render can route traffic.
# HOST=127.0.0.1

# Set to production so secure cookies and the JWT_SECRET check activate.
# NODE_ENV=production